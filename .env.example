# ==========================================
# SECURITY CONFIGURATION
# Copy this file to .env and change the values!
# ==========================================

# Session secret (use a long random string, min 32 chars)
SESSION_SECRET=change_me_to_a_long_random_secret_string_at_least_32_chars

# Encryption key for sensitive JSON data at rest (32-byte hex = 64 chars)
ENCRYPTION_KEY=change_me_to_a_64_char_hex_encryption_key_for_aes256_gcm

# Comma separated list of allowed CORS origins.
# Leave EMPTY to allow same-origin requests only (recommended — most secure).
# Add specific origins if you really need cross-origin access, e.g.:
# ALLOWED_ORIGINS=http://localhost:8080,https://your-tunnel.example
ALLOWED_ORIGINS=

# Set to "production" to hide stack traces and enable secure cookies
NODE_ENV=development

# Server port
PORT=8080

# Web Push (VAPID) - untuk fitur notifikasi push PWA.
# Generate dengan: npx web-push generate-vapid-keys --json
# atau jalankan `node -e "const wp=require('web-push'); console.log(wp.generateVAPIDKeys())"`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@animehub.local
