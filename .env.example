# ==========================================
# SECURITY CONFIGURATION
# Copy this file to .env and change the values!
# ==========================================

# Session secret (use a long random string, min 32 chars)
SESSION_SECRET=change_me_to_a_long_random_secret_string_at_least_32_chars

# Encryption key for sensitive JSON data at rest (32-byte hex = 64 chars)
ENCRYPTION_KEY=change_me_to_a_64_char_hex_encryption_key_for_aes256_gcm

# Comma separated list of allowed CORS origins.
# Use * (or leave empty) to reflect the request origin so the app works behind
# tunnels (serveo/cloudflare) and LAN IPs. Set specific origins to lock it down, e.g.:
# ALLOWED_ORIGINS=http://localhost:8080,https://your-tunnel.example
ALLOWED_ORIGINS=*

# Set to "production" to hide stack traces and enable secure cookies
NODE_ENV=development

# Server port
PORT=8080
